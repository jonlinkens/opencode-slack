{
  "name": "opencode-slack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "oxfmt --check && oxlint && tsc --noEmit && vitest run",
    "changeset": "changeset",
    "version": "changeset version && bun install && oxfmt",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@opencode/plugin": "2.4.1",
    "@oxlint/plugins": "1.95.0",
    "@types/node": "^22.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.7"
  }
}
